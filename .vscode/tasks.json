{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "git-status-check",
			"type": "shell",
			"command": "git",
			"args": [
				"status",
				"-sb"
			]
		},
		{
			"label": "git-porcelain-count",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-Command",
				"$s = git status --porcelain=v1; Write-Output \"COUNT=$($s.Count)\"; $s | Select-Object -First 5"
			]
		},
		{
			"label": "git-commit-attempt",
			"type": "shell",
			"command": "git",
			"args": [
				"commit",
				"-m",
				"Update project files"
			]
		},
		{
			"label": "count-output-lines",
			"type": "shell",
			"command": "powershell",
			"args": [
